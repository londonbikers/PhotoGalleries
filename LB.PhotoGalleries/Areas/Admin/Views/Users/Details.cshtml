@using LB.PhotoGalleries.Shared
@model User
@{
    ViewData["Title"] = $"User: {Model.Name}";
    var galleriesCount = (int)ViewData["galleriesCount"];
    var commentsCount = (int)ViewData["commentsCount"];
    var message = (string)TempData["message"];
}

<h1>User Details</h1>

@if (message.HasValue())
{
    <div class="alert alert-success" role="alert">@message</div>
}

<div>
    <h4>User</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-5">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-sm-5">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-5">
            @Html.DisplayNameFor(model => model.Picture)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Picture)
        </dd>
        
        @if (ViewData.Model.PictureHostedUrl.HasValue())
        {
            <dt class="col-sm-5">
                @Html.DisplayNameFor(model => model.PictureHostedUrl)
            </dt>
            <dd class="col-sm-10">
                <img src="@ViewData.Model.PictureHostedUrl" width="50" title="@ViewData.Model.Name" class="comment-user-pic rounded" />
                <form asp-action="RemovePicture" asp-route-id="@Model.Id" method="post" class="d-inline-block" onsubmit="return confirm('Remove this user\'s picture? It won\'t come back when they next sign in, unless they change their picture.');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove picture</button>
                </form>
            </dd>
        }

        @if (ViewData.Model.RemovedPictureUrl.HasValue())
        {
            <dt class="col-sm-5">
                @Html.DisplayNameFor(model => model.RemovedPictureUrl)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.RemovedPictureUrl)
                <div class="small text-muted">Removed by an admin. Won't be used again unless they change their picture.</div>
            </dd>
        }

        <dt class="col-sm-5">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class="col-sm-5">
            @Html.DisplayNameFor(model => model.PartitionKey)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PartitionKey)
        </dd>
        <dt class="col-sm-5">
            @Html.DisplayNameFor(model => model.Created)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Created)
        </dd>
        
        <dt class="col-sm-5">
            @Html.DisplayNameFor(model => model.LegacyApolloId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LegacyApolloId)
        </dd>

        <dt class="col-sm-5">
            Number of galleries
        </dt>
        <dd class="col-sm-10">
            @galleriesCount
        </dd>

        <dt class="col-sm-5">
            Number of comments
        </dt>
        <dd class="col-sm-10">
            @commentsCount
        </dd>

    </dl>
</div>
<div>
    <a asp-action="Index">Back to List</a>
</div>
