@using LB.PhotoGalleries.Application
@using LB.PhotoGalleries.Shared
@using LB.PhotoGalleries.Models.Utilities
@model PagedResultSet<CommentAdminStub>
@{
    ViewData["Title"] = "Comments Admin";
    var users = (Dictionary<string, User>)ViewData["users"];
    var searchString = (string)ViewData["searchString"];
    var userId = (string)ViewData["userId"];
    var message = (string)TempData["message"];
    const int maxPagesToDisplayInNav = 6;
    var pageNumbers = Model.GetNavigationPageNumbers(Math.Min(Model.TotalPages, maxPagesToDisplayInNav));
    var currentUrl = PageUrl(Model.CurrentPage);
}

@functions {
    int PageSize => (int)ViewData["pageSize"];
    int? PageSizeParam => PageSize == Helpers.DefaultAdminPageSize ? null : PageSize;

    // builds a url for the comments list, leaving out any parameters that are at their default value
    string PageUrl(int page) => Url.Action("Index", new
    {
        q = (string)ViewData["searchString"],
        u = (string)ViewData["userId"],
        p = page > 1 ? page : (int?)null,
        n = PageSizeParam
    });

    string UserName(Dictionary<string, User> users, string id)
    {
        if (id == Constants.AnonUserId)
            return "Deleted user";

        return users.TryGetValue(id ?? string.Empty, out var user) ? user.Name : "Unknown user";
    }
}

<h1>Comments</h1>

@if (message.HasValue())
{
    <div class="alert alert-success" role="alert">@message</div>
}

<form asp-controller="Comments" asp-action="Index" method="get">
    @if (userId.HasValue())
    {
        <input type="hidden" name="u" value="@userId" />
    }
    <div class="form-row align-items-center">
        <div class="col-auto">
            <label class="sr-only" for="q">Search:</label>
            <input type="text" name="q" id="q" value="@searchString" class="form-control mb-2" placeholder="Search comments or users...">
        </div>
        <div class="col-auto">
            <input type="submit" value="Filter" class="btn btn-primary mb-2" />
        </div>
        @if (searchString.HasValue() || userId.HasValue())
        {
            <div class="col-auto">
                <a href="@Url.Action("Index", new { n = PageSizeParam })" class="btn btn-outline-secondary mb-2">Clear</a>
            </div>
        }
        <partial name="_PageSizeSelect" model="PageSize" />
    </div>
</form>

@if (userId.HasValue())
{
    <p>Showing comments by <a asp-controller="Users" asp-action="Details" asp-route-id="@userId">@UserName(users, userId)</a> only.</p>
}

<p class="text-muted">@Model.TotalResults.ToString("N0") @(Model.TotalResults == 1 ? "comment" : "comments")</p>

<table class="table">
    <thead class="thead-dark">
        <tr>
            <th scope="col">User</th>
            <th scope="col">Comment</th>
            <th scope="col">On</th>
            <th scope="col">Created</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Results)
        {
            var user = users.GetValueOrDefault(item.CreatedByUserId ?? string.Empty);
            var categoryNameForUrl = Helpers.EncodeParamForUrl(Server.Instance.Categories.GetCategory(item.GalleryCategoryId)?.Name ?? string.Empty);
            <tr>
                <td>
                    @if (user != null)
                    {
                        if (user.PictureHostedUrl.HasValue())
                        {
                            <img src="@user.PictureHostedUrl" width="30" title="@user.Name" class="comment-user-pic rounded mr-1" />
                        }
                        <a asp-controller="Users" asp-action="Details" asp-route-id="@user.Id">@user.Name</a>
                    }
                    else
                    {
                        <span class="text-muted">@UserName(users, item.CreatedByUserId)</span>
                    }
                </td>
                <td class="text-format">@item.Text</td>
                <td>
                    @if (item.IsImageComment)
                    {
                        <a asp-area="" asp-controller="Images" asp-action="Details" asp-route-galleryId="@item.GalleryId" asp-route-imageId="@item.ImageId" asp-route-name="@Helpers.EncodeParamForUrl(item.ImageName ?? string.Empty)" asp-fragment="c@(item.Created.Ticks)" title="Photo">@(item.ImageName.HasValue() ? item.ImageName : "Untitled photo")</a>
                        <div class="small text-muted">in @item.GalleryName</div>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Galleries" asp-action="Details" asp-route-categoryName="@categoryNameForUrl" asp-route-galleryId="@item.GalleryId" asp-route-name="@Helpers.EncodeParamForUrl(item.GalleryName ?? string.Empty)" asp-fragment="c@(item.Created.Ticks)" title="Gallery">@item.GalleryName</a>
                        <div class="small text-muted">gallery</div>
                    }
                </td>
                <td title="@item.Created.ToString("dddd d MMMM yyyy, HH:mm")" class="text-nowrap">@item.Created.ToString("d MMM yyyy")</td>
                <td>
                    <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this comment? This cannot be undone.');">
                        <input type="hidden" name="categoryId" value="@item.GalleryCategoryId" />
                        <input type="hidden" name="galleryId" value="@item.GalleryId" />
                        <input type="hidden" name="imageId" value="@item.ImageId" />
                        <input type="hidden" name="createdTicks" value="@item.Created.Ticks" />
                        <input type="hidden" name="createdByUserId" value="@item.CreatedByUserId" />
                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Comment pages">
        <ul class="pagination justify-content-center">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item"><a class="page-link" href="@PageUrl(Model.CurrentPage - 1)">Previous</a></li>
            }

            @foreach (var pageNumber in pageNumbers)
            {
                <li class="page-item@(pageNumber == Model.CurrentPage ? " active" : "")"><a class="page-link" href="@PageUrl(pageNumber)">@pageNumber</a></li>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item"><a class="page-link" href="@PageUrl(Model.CurrentPage + 1)">Next</a></li>
            }
            <li class="page-item disabled">
                <span class="page-link">Page @Model.CurrentPage of @Model.TotalPages</span>
            </li>
        </ul>
    </nav>
}
