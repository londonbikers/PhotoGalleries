@model OpenGraphModel
<meta property="og:title" content="@Model.Title" />
<meta property="og:description" content="@Model.Description" />
<meta property="og:type" content="@Model.Type" />
<meta property="og:locale" content="@Model.Locale" />
<meta property="og:site_name" content="@Model.SiteName" />
<meta property="og:url" content="@Model.Url" />
<meta property="fb:app_id" content="@Model.FbAppId" />
@foreach (var image in Model.Images)
{
    <meta property="og:image" content="@image.Url" />
    <meta property="og:image:type" content="@image.ContentType" />
    @if (image.Width.HasValue)
    {
        <meta property="og:image:width" content="@image.Width.Value" />
    }
    @if (image.Height.HasValue)
    {
        <meta property="og:image:height" content="@image.Height.Value" />
    }
}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@@londonbikers">